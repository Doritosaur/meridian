PORT=3000
MIN_AMOUNT_THRESHOLD=1000
ADMIN_API_KEY=changeme

# Supabase Postgres: session pooler or direct URL (not the 6543 transaction pooler)
DATABASE_URL=
# Optional TLS control: DATABASE_SSL=disable|require, DATABASE_SSL_CA=<PEM> to verify the cert
# Upstash Redis: rediss:// URL
REDIS_URL=

# Allowed dashboard origin(s), comma-separated (defaults to *)
DASHBOARD_ORIGIN=

# Optional: omit these values to run without Discord.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
